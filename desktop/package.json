    "set-version": "node ../scripts/set-version.mjs",
    "tauri": "tauri",
    "test": "node --test ui/*.test.mjs ui/autoresponder/*.test.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.5"
  }
