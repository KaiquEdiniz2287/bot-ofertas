{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bot de Ofertas",
  "version": "0.2.0",
  "identifier": "br.com.kaiodiniz.botofertas",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    },
    "windows": [{
      "label": "main",
      "title": "Bot de Ofertas",
      "width": 1180,
      "height": 760,
      "minWidth": 900,
      "minHeight": 620,
      "center": true
    }]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../../dist/bot-ofertas-backend.exe": "bot-ofertas-backend.exe"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
