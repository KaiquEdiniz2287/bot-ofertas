{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bot de Ofertas",
  "version": "0.4.2",
  "identifier": "br.com.kaiodiniz.botofertas",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "main",
        "title": "Bot de Ofertas",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "center": true
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDQUNBMzY4MEJCRjU0NQpSV1JGOWJ1QU5zcktEdDh6Z0YxMTFhUWFhd3lzdkVkSDg3M2NsTWxaVEVrQnY3TjJhd01ac05KVQo=",
      "endpoints": [
        "https://github.com/KaiquEdiniz2287/bot-ofertas/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "../../dist/bot-ofertas-backend.exe": "bot-ofertas-backend.exe"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
